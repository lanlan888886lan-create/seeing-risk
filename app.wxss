/**app.wxss**/

/* ========== 全局按钮体系 ========== */

/* 基础按钮：重置微信 button 默认的 margin/padding，统一尺寸 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: none;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.btn::after {
  border: none;
}

/* 按下态 */
.btn.button-hover {
  opacity: 0.85;
}

/* 禁用/加载态 */
.btn[disabled] {
  opacity: 0.6;
}

/* 主题色按钮 */
.btn-primary {
  background: #20c997;
  color: #ffffff;
}

/* 深色按钮 */
.btn-dark {
  background: #111111;
  color: #ffffff;
}

/* 描边按钮 */
.btn-outline {
  background: #ffffff;
  color: #20c997;
  border: 2rpx solid #20c997;
}

/* 文字链接 */
.btn-link {
  display: block;
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #b0b0b0;
}

/* 按钮组：竖排等间距（24rpx） */
.btn-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 间距工具类 */
.btn-mt {
  margin-top: 24rpx;
}

.btn-mt-lg {
  margin-top: 40rpx;
}
