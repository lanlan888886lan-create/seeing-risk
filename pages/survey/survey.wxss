.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 60rpx 40rpx 80rpx;
  background: linear-gradient(180deg, #e8fff5 0%, #f7fffb 45%, #ffffff 100%);
}

/* 顶部标题 */
.header {
  display: flex;
  flex-direction: column;
  margin-bottom: 50rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  color: #111111;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b8f68;
  margin-bottom: 12rpx;
}

.description {
  font-size: 24rpx;
  color: #7a7a7a;
}

/* 题目卡片 */
.question-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.05);
}

.question-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
  margin-bottom: 24rpx;
}

/* 选项 */
.options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.option {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e3e3e3;
  font-size: 26rpx;
  color: #555555;
  background: #fafafa;
}

.option-active {
  border-color: #20c997;
  background: #e6f9f2;
  color: #149a70;
  font-weight: 600;
}

/* 第 4 题「其他」输入框 */
.other-input-wrap {
  margin-top: 24rpx;
}

.other-input {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e3e3e3;
  border-radius: 16rpx;
  background: #fafafa;
  font-size: 26rpx;
  color: #222222;
}

/* 输入框占位符文案 */
.other-input-ph {
  color: #b0b0b0;
}

/* 聚焦态：WXSS 不支持 :focus，改用类名切换 */
.other-input-focus {
  border-color: #20c997;
  background: #ffffff;
}

