.splash {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #e8fff5 0%, #f7fffb 45%, #ffffff 100%);
}

.logo {
  font-size: 56rpx;
  font-weight: 700;
  color: #111111;
  margin-bottom: 20rpx;
}

.slogan {
  font-size: 28rpx;
  color: #1b8f68;
}
