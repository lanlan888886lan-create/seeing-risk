.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 60rpx 40rpx 80rpx;
  background: linear-gradient(180deg, #e8fff5 0%, #f7fffb 45%, #ffffff 100%);
}

/* 风险等级卡片 */
.risk-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 32rpx;
  padding: 50rpx 36rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid #eeeeee;
}

.risk-card-high {
  background: #fff3f3;
  border-color: #ffd2d2;
}

.risk-card-medium {
  background: #fff9e8;
  border-color: #ffe5a3;
}

.risk-card-low {
  background: #effbf5;
  border-color: #bfe9d4;
}

.risk-label {
  font-size: 26rpx;
  color: #777777;
  margin-bottom: 16rpx;
}

.risk-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #222222;
  margin-bottom: 12rpx;
}

.risk-score {
  font-size: 24rpx;
  color: #999999;
}

/* 信息卡片 */
.section-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
  display: block;
  margin-bottom: 24rpx;
}

/* 过敏原标签 */
.allergen-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.allergen-chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #fdecec;
  color: #d93025;
  font-size: 24rpx;
  font-weight: 600;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #777777;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
  text-align: right;
  flex: 1;
}

/* 空状态 */
.empty-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 80rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 50rpx rgba(0, 0, 0, 0.06);
}

.empty-icon {
  font-size: 90rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222222;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999999;
}
